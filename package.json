{
  "name": "monorepo-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "turbo start",
    "db:up": "docker compose up --detach --wait postgres",
    "db:down": "docker compose down",
    "db:status": "docker compose ps postgres",
    "db:logs": "docker compose logs --follow postgres",
    "db:generate": "pnpm --filter @monorepo/api db:generate",
    "db:migrate": "pnpm --filter @monorepo/api db:migrate",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.1.0",
    "dotenv-cli": "11.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "~1.83.0",
    "turbo": "^2.10.13",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@12.4.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
