{
  "name": "@monorepo/api",
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "start": "dotenv -e ../../.env -- node dist/index.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.7",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
